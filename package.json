{
  "name": "wp-calendar",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --strictPort",
    "build": "vite build && vite build --mode admin && vite build --mode settings",
    "build:pot": "node scripts/build-pot.mjs",
    "build:lang": "node scripts/build-mo.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run tests/integration",
    "build:zip": "npm run build && npm run build:pot && npm run build:lang && node scripts/build-zip.mjs",
    "lint": "eslint --config .github/eslint.config.js src/",
    "lint:fix": "eslint --config .github/eslint.config.js src/ --fix",
    "lint:php": "php vendor/bin/phpcs -d memory_limit=512M --standard=.github/phpcs.xml",
    "lint:php:fix": "php vendor/bin/phpcbf -d memory_limit=512M --standard=.github/phpcs.xml",
    "format": "prettier --config .github/.prettierrc --ignore-path .github/.prettierignore --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --config .github/.prettierrc --ignore-path .github/.prettierignore --check \"src/**/*.{ts,tsx,css}\"",
    "lint:all": "npm run lint && npm run format:check && npm run lint:php"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "moment": "^2.30.1",
    "react": "^18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^7.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
